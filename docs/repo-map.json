  "data_flow": [
    { "step": 0, "from": "Bitvavo REST", "via": "refresh_markets_cache", "to": "bitvavo_markets_cache", "fork": "bitvavo_crypto" },
    { "step": 1, "from": "RSS/CryptoCompare", "via": "RssFetcher.fetch_all / CryptoCompareFetcher.fetch_all", "to": "filter_new", "store": "articles" },
    { "step": 2, "from": "articles", "via": "MarketMapper.map_markets → OllamaClient.analyze_headline", "to": "analyses + suggestions", "store": "analyses" },
    { "step": 3, "from": "analyses", "via": "RulesEngine.apply_rules", "to": "suggestions", "side_effect": "activity_log" },
    { "step": 4, "from": "suggestions", "via": "MarkdownReporter.write_hourly_report", "to": "reports/" },
    { "step": 5, "from": "SchedulerService", "triggers": ["schedule_hourly_digest"], "phase": "1" },
    { "step": 6, "from": "BitvavoSyncService", "to": ["bitvavo_snapshots", "bitvavo_balances"], "phase": "3", "fork": "bitvavo_crypto" },
    { "step": 7, "from": "SQLite", "via": "FastAPI routes", "to": "templates/", "phase": "2" }
  ],
