  "db_models": {
    "articles": {
      "phase": "0",
      "orm_class": "Article",
      "columns": ["id", "url", "title", "summary", "source", "published_at", "content_hash", "fetched_at"],
      "indexes": ["url UNIQUE", "content_hash", "published_at"]
    },
    "analyses": {
      "phase": "0",
      "orm_class": "Analysis",
      "columns": ["id", "article_id", "model", "raw_response", "parsed_json", "created_at"],
      "fk": ["article_id → articles.id"]
    },
    "suggestions": {
      "phase": "0",
      "status": "exists",
      "orm_class": "Suggestion",
      "columns": ["id", "analysis_id", "market", "action", "confidence", "rationale", "event_type", "visible", "created_at"],
      "fk": ["analysis_id → analyses.id"],
      "action_enum": ["would_buy", "would_sell", "would_reduce", "would_hold", "no_action"]
    },
    "bitvavo_markets_cache": {
      "phase": "0",
      "status": "exists",
      "columns": ["market", "base", "quote", "status", "updated_at"],
      "fork": "bitvavo_crypto"
    },
    "trader_config": {
      "phase": "0",
      "status": "exists",
      "columns": ["id", "allocation_eur", "reserve_eur", "isolation_mode", "subaccount_id", "attribution_start"],
      "fork": "bitvavo_crypto"
    },
    "activity_log": {
      "phase": "0",
      "orm_class": "ActivityLogEntry",
      "columns": ["id", "timestamp", "level", "event_type", "message", "metadata_json"],
      "levels": ["info", "warn", "error"],
      "event_type_enum": ["trade", "news", "analysis", "sync", "system", "idle"]
    },
    "runs": {
      "phase": "0",
      "orm_class": "RunRecord",
      "columns": ["id", "type", "started_at", "finished_at", "articles_processed"],
      "type_enum": ["hourly", "trigger", "daily"]
    },
    "ibkr_snapshots": {
      "phase": "3",
      "orm_class": "IbkrSnapshot",
      "columns": ["id", "time", "daily_pnl", "total_unrealized", "net_liq"]
    },
    "ibkr_positions": {
      "phase": "3",
      "orm_class": "IbkrPosition",
      "columns": ["id", "symbol", "qty", "avg_cost", "mkt_value", "unrealized", "daily_pnl", "synced_at"]
    },
    "ibkr_executions": {
      "phase": "3",
      "orm_class": "IbkrExecution",
      "columns": ["id", "symbol", "qty", "price", "side", "time", "realized_pnl"]
    },
    "suggestion_trades": {
      "phase": "4",
      "orm_class": "SuggestionTrade",
      "columns": ["id", "suggestion_id", "ibkr_order_id", "ibkr_execution_id", "linked_at"],
      "fk": ["suggestion_id → suggestions.id"]
    }
  },
